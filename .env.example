# Copy to .env.local for local development. Never commit the real values.
# The site builds and the pages render without these. The sign-up form
# then tells people that sign-up is not open yet, and stores nothing.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Resend segment id for the newsletter list.
# Resend renamed audiences to segments. Create a segment and paste its id here.
# The form adds a contact to this segment. It does not send any email.
RESEND_AUDIENCE_ID=

# Public site URL used for canonical links, the sitemap, RSS and llms.txt.
# No trailing slash. Set this to the real domain before you share the site.
NEXT_PUBLIC_SITE_URL=https://whatsnextsk9.vercel.app
